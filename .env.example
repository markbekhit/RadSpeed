# Copy to .env and fill in — never commit .env to version control.

VOXRAD_WEB_PASSWORD=changeme

# Transcription — Groq Whisper (~200 ms, free tier at https://console.groq.com)
VOXRAD_TRANSCRIPTION_API_KEY=gsk_...
VOXRAD_TRANSCRIPTION_BASE_URL=https://api.groq.com/openai/v1
VOXRAD_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Report formatting — OpenAI
VOXRAD_TEXT_API_KEY=sk-...
VOXRAD_TEXT_BASE_URL=https://api.openai.com/v1
VOXRAD_TEXT_MODEL=gpt-5.6-sol

# Optional real-time medical transcription
# VOXRAD_STREAMING_STT_PROVIDER=deepgram
# DEEPGRAM_API_KEY=...
# ASSEMBLYAI_API_KEY=...
