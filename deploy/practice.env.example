# RadSpeed practice profile — example environment for an Australian
# radiology practice deployment. Copy to /opt/radspeed/.env on the server.
#
# Everything patient-related stays in Australia: speech-to-text on Deepgram's
# Sydney endpoint, report formatting on Claude via Amazon Bedrock's Australian
# inference profile, and hosting on AWS Sydney. See docs/practice-deployment.md.

# ---- Profile -----------------------------------------------------------------
RADSPEED_PROFILE=practice
# Implied by the profile (listed so they can be tuned):
# RADSPEED_DATA_RESIDENCY=au
# RADSPEED_REQUIRE_SSO=true
# RADSPEED_SESSION_MAX_AGE_SECONDS=43200
# RADSPEED_SESSION_IDLE_TIMEOUT_SECONDS=1800
# RADSPEED_STRICT_ORIGIN=true
# RADSPEED_MINIMISE_LLM_IDENTIFIERS=true
# RADSPEED_AI_DISCLOSURE_FOOTER=true
# RADSPEED_AI_DISCLOSURE_TEXT=AI-assisted draft (RadSpeed). Reviewed and signed by {radiologist} on {date}.
# RADSPEED_RESEARCH_FEATURES=false
# RADSPEED_RETENTION_DAYS=30
# RADSPEED_OUTBOX_RETENTION_DAYS=14

# ---- Sign-in (single sign-on is mandatory in this profile) -------------------
OAUTH_REDIRECT_BASE_URL=https://radspeed.example-practice.com.au
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# or GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET
RADSPEED_ADMIN_EMAILS=it.manager@example-practice.com.au
SESSION_SECRET_KEY=

# ---- Speech to text: Deepgram Australia (Sydney) -----------------------------
VOXRAD_STREAMING_STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_REGION=au
DEEPGRAM_MIP_OPT_OUT=true

# ---- Report formatting: Claude on Amazon Bedrock, Australian profile ---------
RADSPEED_TEXT_PROVIDER=bedrock-anthropic
BEDROCK_REGION=ap-southeast-2
# A long-term Bedrock API key from the Bedrock console (API keys page).
VOXRAD_TEXT_API_KEY=
VOXRAD_TEXT_MODEL=au.anthropic.claude-sonnet-5

# ---- Integration -------------------------------------------------------------
VOXRAD_HL7_ENABLED=true
VOXRAD_HL7_OUTBOX=/data/hl7_outbox
VOXRAD_HL7_INBOX=/data/hl7_inbox
VOXRAD_HL7_SENDING_FACILITY=RADSPEED
VOXRAD_HL7_RECEIVING_FACILITY=
VOXRAD_MWL_AGENT_TOKEN=
